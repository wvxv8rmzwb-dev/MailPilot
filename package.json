{
  "name": "mailpilot",
  "version": "1.0.0",
  "description": "Envoi d'emails programmables, pilotable depuis Claude Code via MCP",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "service:install": "node scripts/service.js install",
    "service:uninstall": "node scripts/service.js uninstall"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "better-sqlite3": "^12.4.1",
    "gsap": "^3.15.0",
    "hono": "^4.9.0",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^7.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^7.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
